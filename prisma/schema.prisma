// Prisma Schema for Seeyam Technologies Platform
// IT Training, Certification & Placement Management

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SeoSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("seo_settings")
}

// ─── Enums ──────────────────────────────────────────────

enum Role {
  ADMIN
  COUNSELOR
}

enum Mode {
  CLASSROOM
  ONLINE
  HYBRID
}

enum BatchStatus {
  UPCOMING
  ONGOING
  COMPLETED
}

enum LeadStatus {
  NEW
  CONTACTED
  COUNSELING
  ENROLLED
  DROPPED
}

enum ResourceType {
  RESUME_TEMPLATE
  PRACTICE_SHEET
  BROCHURE
  SYLLABUS_PDF
}

// ─── Models ─────────────────────────────────────────────

model User {
  active       Boolean  @default(true)
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(COUNSELOR)
  branchId     String?
  branch       Branch?  @relation(fields: [branchId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Category {
  description String?
  id      String   @id @default(cuid())
  name    String   @unique
  slug    String   @unique
  icon    String   @default("BookOpen")
  courses Course[]

  @@map("categories")
}

model Course {
  expectedSalary String?
  rating Float?
  enrolledCount Int?
  highlights String[] @default([])
  hiringPartners String[] @default([])
  id               String              @id @default(cuid())
  title            String
  slug             String              @unique
  categoryId       String
  category         Category            @relation(fields: [categoryId], references: [id])
  summary          String              @db.Text
  duration         String
  mode             Mode                @default(CLASSROOM)
  price            Float               @default(0)
  syllabusJson     Json?
  syllabusModules  Json?               // Array of { moduleTitle: string, topics: string[] }
  brochureUrl      String?             @db.Text
  isFeatured       Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  batches          Batch[]
  leads            Lead[]
  placementStories PlacementStory[]
  faqs             FAQ[]
  interviewQuestions InterviewQuestion[]
  resources        Resource[]

  @@map("courses")
}

model Batch {
  instructorExp String?
  id             String      @id @default(cuid())
  courseId       String
  course         Course      @relation(fields: [courseId], references: [id])
  branchId       String
  branch         Branch      @relation(fields: [branchId], references: [id])
  instructorName String
  startDate      DateTime
  timing         String
  maxSeats       Int         @default(30)
  seatsLeft      Int         @default(30)
  status         BatchStatus @default(UPCOMING)
  createdAt      DateTime    @default(now())

  @@map("batches")
}

model Branch {
  email String?
  timing String?
  landmark String?
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  address     String  @db.Text
  city        String
  phone       String
  whatsapp    String
  mapEmbedUrl String? @db.Text
  users       User[]
  batches     Batch[]
  leads       Lead[]

  @@map("branches")
}

model Lead {
  source String?
  reason String?
  brochureUrl String?
  id        String     @id @default(cuid())
  fullName  String
  email     String
  phone     String
  branchId  String?
  branch    Branch?    @relation(fields: [branchId], references: [id])
  courseId  String?
  course    Course?    @relation(fields: [courseId], references: [id])
  status    LeadStatus @default(NEW)
  notes     Json?      // Array of { timestamp, text, author }
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("leads")
}

model PlacementStory {
  branchId String?
  quote String?
  previousRole String?
  linkedinUrl String?
  id               String  @id @default(cuid())
  studentName      String
  companyName      String
  role             String
  packageCtc       String
  studentAvatarUrl String?
  courseId         String?
  course           Course? @relation(fields: [courseId], references: [id])

  @@map("placement_stories")
}

model FAQ {
  legacyCourseId String?
  category String?
  id        String   @id @default(cuid())
  question  String   @db.Text
  answer    String   @db.Text
  courseId  String?
  course    Course?  @relation(fields: [courseId], references: [id])
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@map("faqs")
}

model InterviewQuestion {
  legacyCourseId String?
  id        String   @id @default(cuid())
  courseId  String?
  course    Course?  @relation(fields: [courseId], references: [id])
  question  String   @db.Text
  answer    String?  @db.Text
  category  String   // e.g. "Power BI", "SQL", "Tableau", "Python"
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@map("interview_questions")
}

model Resource {
  legacyCourseId String?
  fileSize String?
  category String?
  description String?
  id        String       @id @default(cuid())
  title     String
  type      ResourceType
  fileUrl   String       @db.Text
  courseId  String?
  course    Course?      @relation(fields: [courseId], references: [id])
  createdAt DateTime     @default(now())

  @@map("resources")
}

model JobPortalLink {
  icon String?
  badge String?
  id         String   @id @default(cuid())
  siteName   String
  url        String   @db.Text
  roleFilter String   // e.g. "data-analyst", "bi-developer", "digital-marketer"
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  @@map("job_portal_links")
}

model BlogPost {
  slug String @id
  title String
  content Json
  @@map("blog_posts")
}

model HiringPartner {
  name String @id
  logoText String
  badge String
  @@map("hiring_partners")
}

model SiteSetting {
  key String @id
  value Json
  @@map("site_settings")
}

model Review {
  id String @id @default(cuid())
  studentName String
  studentEmail String
  courseId String
  branchId String
  rating Int
  title String
  body String
  completionYear String
  status String
  adminNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("reviews")
}

model CmsDocument {
  kind String
  id String
  draft Json
  previousSeo Json? @map("previous_seo")
  published Json?
  withdrawn Boolean @default(false)
  version Int @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  history CmsHistory[]
  media CmsMediaUsage[]
  @@id([kind,id])
  @@map("cms_documents")
}

model CmsHistory {
  eventId BigInt @id @default(autoincrement()) @map("event_id")
  kind String
  id String
  version Int
  action String
  actorId String @map("actor_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  document CmsDocument @relation(fields:[kind,id], references:[kind,id],onDelete:NoAction,onUpdate:NoAction)
  @@unique([kind,id,version])
  @@map("cms_history")
}

model CmsMedia {
  id String @id @db.Uuid
  name String
  category String @default("")
  mime String
  size Int
  provider String
  deleting Boolean @default(false)
  storageKey String @unique @map("storage_key")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  usage CmsMediaUsage[]
  @@map("cms_media")
}

model CmsMediaUsage {
  kind String
  id String
  mediaId String @map("media_id") @db.Uuid
  stage String
  document CmsDocument @relation(fields:[kind,id],references:[kind,id],onDelete:NoAction,onUpdate:NoAction)
  media CmsMedia @relation(fields:[mediaId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  @@id([kind,id,mediaId,stage])
  @@index([mediaId,stage],map:"cms_media_lookup")
  @@map("cms_media_usage")
}

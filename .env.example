# Copy to .env.local and enter your own deployment values.
NEXT_PUBLIC_SITE_URL=http://localhost:3002
WORDPRESS_API_URL=http://seeyam.local/wp-json/wp/v2
# Match the secret configured in WordPress > Seeyam Platform Settings.
REVALIDATE_SECRET=

# Required for production admin login and for SEO writes in every environment.
SESSION_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Set a counselor password if that account is used in production.
COUNSELOR_PASSWORD=
# Server-only Neon PostgreSQL connection string for SEO settings.
DATABASE_URL=
